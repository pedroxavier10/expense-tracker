# Application
APP_NAME="Expense Tracker API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://expense_user:expense_pass@localhost:5466/expense_tracker

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_in_production_use_a_long_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Default user (created on first run for personal use)
DEFAULT_USER_EMAIL=me@example.com
DEFAULT_USER_PASSWORD=changeme

# LLM (OpenAI-compatible client; defaults target a local Ollama daemon)
# To use OpenAI instead: set LLM_BASE_URL=https://api.openai.com/v1, LLM_API_KEY=sk-...,
# LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_ITERATIONS=5
