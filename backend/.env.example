# Application
APP_NAME="Expense Tracker API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+psycopg://expense_user:expense_pass@localhost:5466/expense_tracker

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change_me_in_production_use_a_long_random_string_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication
# Google sign-in is the only login in production (it is enforced: the API refuses
# to start with ENVIRONMENT=production and GOOGLE_AUTH_ENABLED=false).
# Set to false in development to use the passwordless dev login as DEV_USER_EMAIL.
GOOGLE_AUTH_ENABLED=false
# OAuth 2.0 Client ID (type "Web application") from Google Cloud Console.
# Required when GOOGLE_AUTH_ENABLED=true.
GOOGLE_CLIENT_ID=
# Comma-separated emails allowed to sign in with Google. Each email is its own account.
ALLOWED_EMAILS=
DEV_USER_EMAIL=me@example.com

# LLM (OpenAI-compatible client; defaults target a local Ollama daemon)
# To use OpenAI instead: set LLM_BASE_URL=https://api.openai.com/v1, LLM_API_KEY=sk-...,
# LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.2
# Optional: small/fast model for short utility tasks (e.g. slug generation). Falls back to LLM_MODEL if unset.
# LLM_UTILITY_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_MAX_TOOL_ITERATIONS=6

# Recurring-expense suggestions: distinct months an expense must repeat before it is suggested.
RECURRING_SUGGESTION_MIN_MONTHS=3
